RedirectMatch 301 ^/play/earthquake/ci/production(/.*)?$ https://vaultlearninggames.org/earthquake#play
RedirectMatch 301 ^/play/emerald/ci/production(/.*)?$ https://vaultlearninggames.org/legend-of-the-lost-emerald#play
RedirectMatch 301 ^/play/forevermine/ci/production(/.*)?$ https://vaultlearninggames.org/forever-mine#play
RedirectMatch 301 ^/play/headlines/ci/production(/.*)?$ https://vaultlearninggames.org/headlines-and-high-water#play
RedirectMatch 301 ^/play/jowilder/ci/production(/.*)?$ https://vaultlearninggames.org/jowilder#play
RedirectMatch 301 ^/play/lakeland/ci/production(/.*)?$ https://vaultlearninggames.org/lakeland#play
RedirectMatch 301 ^/play/magnet/ci/production(/.*)?$ https://vaultlearninggames.org/magnet-hunt#play
RedirectMatch 301 ^/play/nitrogen-game/ci/production(/.*)?$ https://vaultlearninggames.org/nitrogen-cycle-game#play
RedirectMatch 301 ^/play/project-hercules/ci/production(/.*)?$ https://vaultlearninggames.org/project-hercules#play
RedirectMatch 301 ^/play/projecthercules/ci/production(/.*)?$ https://vaultlearninggames.org/project-hercules#play
RedirectMatch 301 ^/play/thermolab/ci/production(/.*)?$ https://vaultlearninggames.org/thermolab#play
RedirectMatch 301 ^/play/wake/ci/production(/.*)?$ https://vaultlearninggames.org/wake#play
RedirectMatch 301 ^/play/water-game/ci/production(/.*)?$ https://vaultlearninggames.org/water-cycle-game#play
