Options -Indexes

# /work retired -> get involved
RedirectMatch 301 ^/work(/.*)? /getinvolved/

# 301 redirect original fellowships page to the merged page
RedirectMatch 301 ^/fellowships/?$ /fellowships-incubators/

# Incubator cohort pages retired -> cohort Google Docs
RedirectMatch 301 ^/fellowships-incubators/2026-frontiers-of-biotechnology(/.*)?$ https://docs.google.com/document/d/1lF7dXQfFvWfRmKtryryqbQhTbPj4UUzH5dx4z8IyXHI/edit
RedirectMatch 301 ^/fellowships-incubators/2025-practices-of-life-science(/.*)?$ https://docs.google.com/document/d/1_Ys3TQ19cYKtFCwhJ95X8v4meWKtUTCVYlOVmFAVLk4/edit

# Old game play URLs -> the game's Vault page with the player open (#play), 301. Same block on production
# (fielddaylab.wisc.edu) and wwwtest; Plesk deploys it with the branch. Built 2026-10-06 from every game address in
# this repository's history and every /play address people requested in a year of the server's logs: a game's
# ci/master|main|production (and ThermoVR's ci/desktop) builds, a bare ci/, and its old build folders (game, build, ...).
# Team test builds (ci/develop, ci/staging, ...), the /play/<game>/ pages and their files are left alone.
# "/+" also matches doubled slashes (/play/lakeland//game). mod_rewrite, not RedirectMatch: QSD drops any query
# string (Apache would append it after the fragment, giving "#play?x=y", which Vault doesn't recognise) and NE keeps
# "#" unescaped.
RewriteEngine On
# PBS Wisconsin Education's "Play the game" pages open these games' old addresses in a popup (window.open, which sends
# their Referer). Those players get the game itself from the Vault CDN, without the Vault player's bar, as before
# Vault; everyone else gets the Vault page below. The Vault CDN's Cloudflare rule "CDN builds only play in the Vault
# player" lets exactly these files through for PBS Wisconsin referrers. Each game's own analytics then tells PBS
# players (referrer pbswisconsineducation.org) from Vault players (vaultlearninggames.org). 302, not 301: the
# redirect depends on the Referer, and browsers keep a 301 for the address whoever sent them.
RewriteCond %{HTTP_REFERER} ^https?://([^/]+\.)?pbswisconsineducation\.org(/|$) [NC]
RewriteRule ^play/+jowilder/+game/+iframe\.html$ https://cdn.vaultlearninggames.org/fieldday/jowilder/iframe.html [R=302,L,QSD]
RewriteCond %{HTTP_REFERER} ^https?://([^/]+\.)?pbswisconsineducation\.org(/|$) [NC]
RewriteRule ^play/+emerald/+ci/+production/*(index\.html)?$ https://cdn.vaultlearninggames.org/fieldday/emerald/ [R=302,L,QSD]
RewriteRule ^play/+wake/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?)$ https://vaultlearninggames.org/wake#play [R=301,L,NE,QSD]
RewriteRule ^play/+(bloom|zavala)/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?)$ https://vaultlearninggames.org/bloom#play [R=301,L,NE,QSD]
RewriteRule ^play/+emerald/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?)$ https://vaultlearninggames.org/legend-of-the-lost-emerald#play [R=301,L,NE,QSD]
RewriteRule ^play/+(headlines|journalism)/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?)$ https://vaultlearninggames.org/headlines-and-high-water#play [R=301,L,NE,QSD]
RewriteRule ^play/+(project-hercules|projecthercules|astrogame)/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?)$ https://vaultlearninggames.org/project-hercules#play [R=301,L,NE,QSD]
RewriteRule ^play/+lakeland/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?|usda(/.*)?)$ https://vaultlearninggames.org/lakeland#play [R=301,L,NE,QSD]
RewriteRule ^play/+forevermine/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?)$ https://vaultlearninggames.org/forever-mine#play [R=301,L,NE,QSD]
RewriteRule ^play/+jowilder/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?|build(/.*)?|capitol_prototype(/.*)?)$ https://vaultlearninggames.org/jowilder#play [R=301,L,NE,QSD]
RewriteRule ^play/+(thermolab|thermovr)/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|game(/.*)?)$ https://vaultlearninggames.org/thermolab#play [R=301,L,NE,QSD]
RewriteRule ^play/+atom-touch/+(ci(/+(master|main|production|desktop)(/.*)?|/*)|build(/.*)?|atom-touch/+build(/.*)?)$ https://vaultlearninggames.org/atom-touch#play [R=301,L,NE,QSD]
RewriteRule ^play/+antibiotic/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/antibiotic-resistance#play [R=301,L,NE,QSD]
RewriteRule ^play/+balloon/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/hot-air-balloon#play [R=301,L,NE,QSD]
RewriteRule ^play/+carbon-game/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/carbon-cycle-game#play [R=301,L,NE,QSD]
RewriteRule ^play/+crystal-cave/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/crystal-cave#play [R=301,L,NE,QSD]
RewriteRule ^play/+earthquake/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/earthquake#play [R=301,L,NE,QSD]
RewriteRule ^play/+magnet/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/magnet-hunt#play [R=301,L,NE,QSD]
RewriteRule ^play/+nitrogen-game/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/nitrogen-cycle-game#play [R=301,L,NE,QSD]
RewriteRule ^play/+water-game/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/water-cycle-game#play [R=301,L,NE,QSD]
RewriteRule ^play/+wave/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/wave-combinator#play [R=301,L,NE,QSD]
RewriteRule ^play/+wind/+(ci(/+(master|main|production|desktop)(/.*)?|/*))$ https://vaultlearninggames.org/wind-simulator#play [R=301,L,NE,QSD]
RewriteRule ^play/+partner/+transformation-quest/+ci(/.*)?$ https://vaultlearninggames.org/transformations-quest#play [R=301,L,NE,QSD]
# Games not on Vault whose old builds are gone: their page here instead of a 404.
RewriteRule ^play/+(alien-gardener|ice-cube|thestationmaine)/+(build|game)(/.*)?$ /play/$1/ [R=301,L,QSD]
